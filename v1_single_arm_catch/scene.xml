<mujoco model="single_arm_catch_v1">
  <!-- UR5e + cup (ur5e_cup.xml) and a thrown ball. Contact parameters follow v0. -->
  <include file="ur5e_cup.xml"/>

  <option timestep="0.001" integrator="implicitfast"/>

  <statistic extent="1.6" center="0.6 0 0.5"/>

  <visual>
    <global azimuth="150" elevation="-15" offwidth="1280" offheight="720"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
  </visual>

  <default>
    <geom solref="0.003 0.5" solimp="0.95 0.99"/>
  </default>

  <asset>
    <texture type="skybox" colorspace="auto" name="sky" builtin="gradient" rgb1="0.6 0.8 1" rgb2="0.1 0.2 0.3" width="256" height="1536"/>
    <texture type="2d" colorspace="auto" name="grid" builtin="checker" rgb1="0.85 0.85 0.85" rgb2="0.7 0.7 0.7" width="512" height="512"/>
    <material name="ground" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <material name="ball" rgba="0.9 0.1 0.1 1"/>
    <material name="launcher" rgba="0.3 0.3 0.3 0.6"/>
  </asset>

  <worldbody>
    <geom name="ground" size="3 3 0.1" type="plane" material="ground"/>
    <!-- Straight down: a slanted directional light caused shadow acne (speckles) on the ground. -->
    <light pos="0 0 2.5" dir="0 0 -1" type="directional"/>
    <camera name="side" pos="0.9 -1.9 0.9" xyaxes="1 0.35 0 -0.07 0.2 1"/>

    <!-- Purely visual marker of the throw origin (no collision). -->
    <geom name="launcher" type="cylinder" size="0.05 0.3" pos="1.8 0 0.3" material="launcher"
          contype="0" conaffinity="0"/>

    <body name="ball" pos="1.8 0 0.65">
      <joint name="ball_free" type="free"/>
      <geom name="ball" size="0.035" condim="6" friction="0.8 0.005 0.0005" mass="0.057" material="ball"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- "ready": cup_mouth at (0.45, 0, 0.50), cup facing up, walls aligned with world x/y. -->
    <key name="ready"
         qpos="0.302 -1.649 -2.206 -0.857 -1.571 -1.873  1.8 0 0.65 1 0 0 0"
         ctrl="0.302 -1.649 -2.206 -0.857 -1.571 -1.873"/>
  </keyframe>
</mujoco>
