<mujoco model="two_arm_s1_v3">
  <!-- Two UR5e + cup arms side by side, both facing +x, and two balls (pattern S1).
       Arm A stands at +y, arm B at -y; each is the same ur5e_cup.xml, attached with a prefix
       (a_ / b_). The base half-spacing (0.45 m here) is changed by s1_geometry.py through
       MjSpec (frames a_mount / b_mount). Contact parameters of the attached arms must match
       arm_scene.xml (planning model); s1_geometry.load_two_arm_model() checks that. -->
  <compiler angle="radian"/>
  <option timestep="0.001" integrator="implicitfast"/>

  <statistic extent="2.0" center="0.5 0 0.5"/>

  <visual>
    <global azimuth="180" elevation="-15" offwidth="1280" offheight="720"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
  </visual>

  <default>
    <geom solref="0.003 0.5" solimp="0.95 0.99"/>
  </default>

  <asset>
    <model name="arm" file="ur5e_cup.xml"/>
    <texture type="skybox" colorspace="auto" name="sky" builtin="gradient" rgb1="0.6 0.8 1" rgb2="0.1 0.2 0.3" width="256" height="1536"/>
    <texture type="2d" colorspace="auto" name="grid" builtin="checker" rgb1="0.85 0.85 0.85" rgb2="0.7 0.7 0.7" width="512" height="512"/>
    <material name="ground" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <material name="ball1" rgba="0.9 0.1 0.1 1"/>
    <material name="ball2" rgba="0.95 0.75 0.1 1"/>
  </asset>

  <worldbody>
    <geom name="ground" size="3 3 0.1" type="plane" material="ground"/>
    <light pos="0 0 2.5" dir="0 0 -1" type="directional"/>
    <!-- Facing both arms from the front (+x). -->
    <camera name="front" pos="2.2 0 1.0" xyaxes="0 1 0 -0.2 0 1"/>
    <camera name="three_quarter" pos="1.7 -1.2 1.1" xyaxes="0.577 0.817 0 -0.25 0.177 0.952"/>

    <frame name="a_mount" pos="0 0.45 0">
      <attach model="arm" body="base" prefix="a_"/>
    </frame>
    <frame name="b_mount" pos="0 -0.45 0">
      <attach model="arm" body="base" prefix="b_"/>
    </frame>

    <!-- Balls start parked; the experiment places them in the cups. -->
    <body name="ball1" pos="2 0.3 0.035">
      <joint name="ball1_free" type="free"/>
      <geom name="ball1" size="0.035" condim="6" friction="0.8 0.005 0.0005" mass="0.057" material="ball1"/>
    </body>
    <body name="ball2" pos="2 -0.3 0.035">
      <joint name="ball2_free" type="free"/>
      <geom name="ball2" size="0.035" condim="6" friction="0.8 0.005 0.0005" mass="0.057" material="ball2"/>
    </body>
  </worldbody>
</mujoco>
