<mujoco model="hand_grasp_v4">
  <!-- UR5e + LEAP hand (ur5e_leap.xml) and one ball sized like a juggling ball for this hand:
       LEAP is ~1.3x a human hand (Shaw et al., RSS 2023), so the common adult 65-67 mm / 120 g
       beanbag becomes 85 mm; the mass stays at the standard 120 g (the hand's grip is about a
       human's, not 1.3^3 times stronger). Load through handsim.load_model(), which also sets the
       hand's gravity compensation and finger torque limits. -->
  <include file="ur5e_leap.xml"/>

  <!-- elliptic cone + high impratio as recommended by the Menagerie LEAP model (stable grasps) -->
  <option timestep="0.001" integrator="implicitfast" cone="elliptic" impratio="100"/>

  <statistic extent="1.2" center="0.45 0 0.55"/>

  <visual>
    <global azimuth="150" elevation="-20" offwidth="1280" offheight="720"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <texture type="skybox" colorspace="auto" name="sky" builtin="gradient" rgb1="0.6 0.8 1" rgb2="0.1 0.2 0.3" width="256" height="1536"/>
    <texture type="2d" colorspace="auto" name="grid" builtin="checker" rgb1="0.85 0.85 0.85" rgb2="0.7 0.7 0.7" width="512" height="512"/>
    <material name="ground" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <material name="ball" rgba="0.9 0.1 0.1 1"/>
  </asset>

  <worldbody>
    <geom name="ground" size="3 3 0.1" type="plane" material="ground" solref="0.003 0.5" solimp="0.95 0.99"/>
    <light pos="0 0 2.5" dir="0 0 -1" type="directional"/>
    <camera name="side" pos="0.45 -1.0 0.75" xyaxes="1 0 0 0 0.25 1"/>
    <camera name="close" pos="0.75 -0.35 0.75" xyaxes="0.76 0.65 0 -0.25 0.3 0.92"/>
    <!-- aimed at the E2 throw region (release point ~ (0.85, 0, 0.3) flange, ball ~0.15 m higher) -->
    <camera name="throw" pos="1.5 -0.9 0.7" xyaxes="0.832 0.555 0 -0.125 0.187 0.975"/>
    <!-- E3b (hand_juggle.py): the throw camera raised for the 0.4 m pedestal -->
    <camera name="loop" pos="1.6 -1.0 1.15" xyaxes="0.832 0.555 0 -0.125 0.187 0.975"/>

    <body name="ball" pos="1.5 0 0.0425">
      <joint name="ball_free" type="free"/>
      <!-- An ordinary ball (same contact as v0-v2's): the compliance of a catch comes from the hand
           (handsim.load_model softens the palm and fingertip contacts) and the arm giving way. -->
      <geom name="ball" size="0.0425" condim="6" friction="0.8 0.005 0.0005" mass="0.12"
            solref="0.003 0.5" solimp="0.95 0.99" material="ball"/>
    </body>
  </worldbody>
</mujoco>
